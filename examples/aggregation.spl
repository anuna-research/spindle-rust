; Run: cargo run -p spindle-cli -- reason examples/aggregation.spl
;
; Current finite-grounding restriction: list every value a variable can take.
; This is a grounding universe, not the rows being summed:
;   alice, bob = people; 1, 2 = payment IDs; 10 = cost; 0, 20 = totals.
; In particular, 20 must be listed even though it is computed by the fold.
; Omitting a possible total can prevent its rule instance from being generated.
(aggregate-domain alice bob 0 1 2 10 20)

(given (person alice))
(given (person bob))
(given (payment alice 1 10))
(given (payment alice 2 10))

; ?person is outer scope; ?id and ?cost are local to each matching row.
(normally payment-total
  (and
    (person ?person)
    (bind ?total
      (fold + ?cost
        :from (payment ?person ?id ?cost)
        :initial 0)))
  (total-payment ?person ?total))

; alice has total 20; bob has total 0. Both use defeasible snapshot evidence.
