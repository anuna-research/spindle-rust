;; SPEC-018: Temporal Atom Identity and Proof Lift via Synthetic Bridging
;; Implementation plan for fixing temporal atom identity collapse (BUG-001)

(meta plan
  (id "IMPL-018")
  (title "Temporal Atom Identity and Proof Lift via Synthetic Bridging")
  (version "1.0.0")
  (status "active")
  (created "2026-03-04")
  (author "agent:architect")
  (spec "SPEC-018")
  (description "Fix temporal atom identity collapse in AtomKey, add synthetic bridging pipeline stage for temporal subsumption, and implement temporal-aware query matching"))

;; Agents
(given agent-coder-available)
(given agent-reviewer-available)

;; ============================================================
;; Phase 1: Identity Fix — AtomKey temporal inclusion
;; ============================================================

(given task-atomkey-temporal)
(given no-deps-atomkey-temporal)

(meta task-atomkey-temporal
  (description "Add temporal: Temporal field to AtomKey struct in index.rs so that p[1,10] and p[20,30] produce distinct AtomId/LitId values")
  (acceptance "TEST-001 and TEST-002 pass: distinct temporal variants produce different AtomIds")
  (context-files "crates/spindle-core/src/index.rs")
  (token-budget "6000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-intern-literal-temporal)

(meta task-intern-literal-temporal
  (description "Update intern_literal and get_lit_id in index.rs to include lit.temporal.clone() in the AtomKey construction")
  (acceptance "Interning includes temporal bounds; existing non-temporal interning unchanged")
  (context-files "crates/spindle-core/src/index.rs")
  (token-budget "4000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-resolve-literal-temporal)

(meta task-resolve-literal-temporal
  (description "Update resolve_literal in index.rs to return key.temporal.clone() instead of Temporal::empty()")
  (acceptance "TEST-003 and TEST-004 pass: resolve_literal roundtrips temporal bounds correctly")
  (context-files "crates/spindle-core/src/index.rs")
  (token-budget "4000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-phase1-tests)

(meta task-phase1-tests
  (description "Write unit tests TEST-001 through TEST-004 and TEST-013 for temporal atom identity and resolve_literal preservation")
  (acceptance "All 5 tests pass: distinct AtomIds for temporal variants, resolve_literal roundtrip, complement preserves temporal")
  (context-files "crates/spindle-core/src/index.rs" "crates/spindle-core/tests/")
  (token-budget "8000")
  (evaluate-checks "test:cargo test -p spindle-core"))

;; Phase 1 dependency chain
(normally r-ready-atomkey-temporal
  (and task-atomkey-temporal no-deps-atomkey-temporal)
  ready-atomkey-temporal)

(normally r-ready-intern-literal-temporal
  (and task-intern-literal-temporal completed-atomkey-temporal)
  ready-intern-literal-temporal)

(normally r-ready-resolve-literal-temporal
  (and task-resolve-literal-temporal completed-intern-literal-temporal)
  ready-resolve-literal-temporal)

(normally r-ready-phase1-tests
  (and task-phase1-tests completed-resolve-literal-temporal)
  ready-phase1-tests)

;; ============================================================
;; Phase 2: Pipeline Stage — TemporalBridge
;; ============================================================

(given task-bridge-stage-impl)

(meta task-bridge-stage-impl
  (description "Implement TemporalBridge as a PipelineStage in new file temporal_bridge.rs: scan temporal heads, generate strict bridging rules q[s,e] -> base(q) and coupled negation bridges ~q[s,e] -> ~base(q)")
  (acceptance "TEST-007 through TEST-010 pass: bridge rules generated for temporal facts, negation bridges generated, no-op for non-temporal theories")
  (context-files "crates/spindle-core/src/pipeline/temporal_bridge.rs" "crates/spindle-core/src/pipeline/mod.rs")
  (token-budget "10000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-bridge-label-determinism)

(meta task-bridge-label-determinism
  (description "Ensure bridge labels use format __bridge::<to_spl()> and __bridge::neg::<to_spl()> with idempotency guard checking for pre-existing labels")
  (acceptance "TEST-018 passes: bridge labels are deterministic and collision-free across repeated applications")
  (context-files "crates/spindle-core/src/pipeline/temporal_bridge.rs")
  (token-budget "4000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-bridge-deduplication)

(meta task-bridge-deduplication
  (description "Implement deduplication by bridge label so that multiple rules sharing the same temporal head produce only one bridge; check for pre-existing __bridge:: labels before generation")
  (acceptance "Duplicate temporal heads produce exactly one bridge rule per distinct temporal literal")
  (context-files "crates/spindle-core/src/pipeline/temporal_bridge.rs")
  (token-budget "4000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-phase2-tests)

(meta task-phase2-tests
  (description "Write unit tests TEST-007 through TEST-010 and TEST-018 for TemporalBridge pipeline stage")
  (acceptance "All 5 tests pass: bridge generation, unconditional generation, negation bridge, no-op for non-temporal, label determinism")
  (context-files "crates/spindle-core/tests/")
  (token-budget "8000")
  (evaluate-checks "test:cargo test -p spindle-core"))

;; Phase 2 dependencies: requires Phase 1 complete, tasks within phase are partially parallel
(normally r-ready-bridge-stage-impl
  (and task-bridge-stage-impl completed-phase1-tests)
  ready-bridge-stage-impl)

(normally r-ready-bridge-label-determinism
  (and task-bridge-label-determinism completed-bridge-stage-impl)
  ready-bridge-label-determinism)

(normally r-ready-bridge-deduplication
  (and task-bridge-deduplication completed-bridge-stage-impl)
  ready-bridge-deduplication)

(normally r-ready-phase2-tests
  (and task-phase2-tests completed-bridge-label-determinism completed-bridge-deduplication)
  ready-phase2-tests)

;; ============================================================
;; Phase 3: Integration — Wire bridge into pipeline
;; ============================================================

(given task-pipeline-integration)

(meta task-pipeline-integration
  (description "Wire TemporalBridge into prepare() pipeline after Ground and before TemporalVarValidation; also add to Pipeline::default_pipeline()")
  (acceptance "Bridge stage runs in pipeline order: Validate -> WildcardRewrite -> Ground -> TemporalBridge -> TemporalVarValidation -> [TemporalFilter]")
  (context-files "crates/spindle-core/src/pipeline/mod.rs" "crates/spindle-core/src/pipeline.rs")
  (token-budget "6000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-integration-tests)

(meta task-integration-tests
  (description "Write integration tests TEST-005, TEST-006, TEST-011, TEST-012, TEST-017 verifying end-to-end temporal bridging, cross-window blocking, defeasible defeat through bridge, and non-temporal backward compatibility")
  (acceptance "All 5 integration tests pass; existing test suite remains green")
  (context-files "crates/spindle-core/tests/")
  (token-budget "10000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-backward-compat-validation)

(meta task-backward-compat-validation
  (description "Run full existing test suite to verify non-temporal theories produce identical results; verify TemporalBridge is no-op for non-temporal theories")
  (acceptance "All pre-existing tests pass without modification; TEST-017 Nixon diamond unchanged")
  (context-files "crates/spindle-core/tests/")
  (token-budget "4000")
  (evaluate-checks "test:cargo test" "test:cargo test -p spindle-parser"))

;; Phase 3 dependencies
(normally r-ready-pipeline-integration
  (and task-pipeline-integration completed-phase2-tests)
  ready-pipeline-integration)

(normally r-ready-integration-tests
  (and task-integration-tests completed-pipeline-integration)
  ready-integration-tests)

(normally r-ready-backward-compat-validation
  (and task-backward-compat-validation completed-integration-tests)
  ready-backward-compat-validation)

;; ============================================================
;; Phase 4: Query Matching — temporal-aware query operators
;; ============================================================

(given task-matches-query-temporal)

(meta task-matches-query-temporal
  (description "Implement matches_query_temporal public function in query/mod.rs: temporal wildcard when query has empty temporal, exact match when non-empty")
  (acceptance "TEST-014 and TEST-015 pass: wildcard matches all variants, specific temporal matches only exact")
  (context-files "crates/spindle-core/src/query/mod.rs")
  (token-budget "4000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-query-operator-updates)

(meta task-query-operator-updates
  (description "Replace Literal::PartialEq comparisons with matches_query_temporal in query/mod.rs (2 sites), query/why_not.rs (1 site), and query/abduce.rs (1 site)")
  (acceptance "TEST-016 and TEST-016b pass: bounded queries reject wrong temporal windows, wildcard queries match all variants")
  (context-files "crates/spindle-core/src/query/mod.rs" "crates/spindle-core/src/query/why_not.rs" "crates/spindle-core/src/query/abduce.rs")
  (token-budget "6000")
  (evaluate-checks "test:cargo test -p spindle-core"))

(given task-phase4-tests)

(meta task-phase4-tests
  (description "Write unit tests TEST-014 through TEST-016b for temporal query matching")
  (acceptance "All 4 tests pass: wildcard matching, exact matching, conclusion list filtering, bounded query false-positive prevention")
  (context-files "crates/spindle-core/tests/")
  (token-budget "8000")
  (evaluate-checks "test:cargo test -p spindle-core"))

;; Phase 4 dependencies
(normally r-ready-matches-query-temporal
  (and task-matches-query-temporal completed-backward-compat-validation)
  ready-matches-query-temporal)

(normally r-ready-query-operator-updates
  (and task-query-operator-updates completed-matches-query-temporal)
  ready-query-operator-updates)

(normally r-ready-phase4-tests
  (and task-phase4-tests completed-query-operator-updates)
  ready-phase4-tests)

;; ============================================================
;; Final: Property-based tests and full validation
;; ============================================================

(given task-pbt-temporal-identity)

(meta task-pbt-temporal-identity
  (description "Implement TEST-PBT-001: proptest that verifies temporal identity bijection — intern(p)==intern(q) iff all fields including temporal match")
  (acceptance "PBT passes 500+ cases with random theories containing 1-10 temporal and non-temporal facts")
  (context-files "crates/spindle-core/tests/")
  (token-budget "8000")
  (evaluate-checks "test:cargo test -p spindle-core pbt"))

(given task-pbt-non-temporal-equivalence)

(meta task-pbt-non-temporal-equivalence
  (description "Implement TEST-PBT-002: proptest that verifies non-temporal theories produce identical conclusions with and without TemporalBridge stage")
  (acceptance "PBT passes 500+ cases using existing proptest generators from difftest.rs")
  (context-files "crates/spindle-core/tests/difftest.rs" "crates/spindle-core/tests/")
  (token-budget "8000")
  (evaluate-checks "test:cargo test -p spindle-core pbt"))

(given task-final-validation)

(meta task-final-validation
  (description "Run complete test suite across all workspace crates, verify zero defeasible.rs modifications, verify all 19 unit tests and 2 PBTs pass")
  (acceptance "cargo test passes for all crates; defeasible.rs is byte-identical to pre-implementation state; no regressions")
  (context-files "crates/")
  (token-budget "4000")
  (evaluate-checks "test:cargo test" "lint:cargo clippy -- -D warnings"))

;; Final phase dependencies
(normally r-ready-pbt-temporal-identity
  (and task-pbt-temporal-identity completed-phase4-tests)
  ready-pbt-temporal-identity)

(normally r-ready-pbt-non-temporal-equivalence
  (and task-pbt-non-temporal-equivalence completed-phase4-tests)
