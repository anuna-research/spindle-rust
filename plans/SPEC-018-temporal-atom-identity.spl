(prefer r-assign-final-validation-reviewer r-assign-final-validation-coder)

(meta r-assign-final-validation-reviewer
  (description "Final validation and sign-off assigned to reviewer")
  (justification "Reviewer verifies zero defeasible.rs modifications and full backward compatibility"))

;; ============================================================
;; Safety constraints / defeaters
;; ============================================================

;; Block integration if Phase 1 tests fail
(except d-block-integration-on-phase1-failure
  failed-phase1-tests
  (not ready-pipeline-integration))

;; Block final validation if any integration test fails
(except d-block-final-on-integration-failure
  failed-integration-tests
  (not ready-final-validation))

;; Block final validation if defeasible.rs was modified (invariant from REQ-005)
(except d-block-final-on-defeasible-modified
  defeasible-rs-modified
  (not ready-final-validation))

;; Block query operator updates if backward compat fails
(except d-block-query-on-compat-failure
  failed-backward-compat-validation
  (not ready-matches-query-temporal))

(meta d-block-final-on-defeasible-modified
  (description "Final validation blocked if defeasible.rs was modified")
  (justification "REQ-005 invariant: zero modifications to the defeasible reasoning module"))

(meta d-block-integration-on-phase1-failure
  (description "Pipeline integration blocked if Phase 1 identity tests fail")
  (justification "Correct AtomKey identity is prerequisite for all downstream phases"))
