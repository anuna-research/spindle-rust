  (target-file "crates/spindle-cli/src/error_report.rs")
  (implements "REQ-103 REQ-205")
  (effort "2h"))

(meta task-from-spindle-error
  (description "Implement From<&SpindleError> for ProblemDetails. Use err.code() for type URI tag:spindle.dev,2026:error:{CODE}, err.category().default_title() for title, err.to_string() for detail, category.exit_code() for exit_code extension. Extract line/column from ParseError variants when available. Per SPEC-010 Section 8.4.")
  (phase "d2-presentation")
  (target-file "crates/spindle-cli/src/error_report.rs")
  (implements "REQ-101 REQ-110")
  (effort "2h"))

(meta task-from-parse-error-pd
  (description "Implement From<&ParseError> for ProblemDetails. Extracts position/line/column directly from ParseError variants. Generates source_context when source text is available.")
  (phase "d2-presentation")
  (target-file "crates/spindle-cli/src/error_report.rs")
  (implements "REQ-101 REQ-110")
  (effort "2h"))

; ===========================================================================
; Metadata: Phase D3 - Wire CLI rendering
; ===========================================================================

(meta task-render-human
  (description "Implement render_human() on ProblemDetails. Format: 'Error: {title}' line, then '--> {source_name}:{line}:{column}' if available, then source context window with line numbers and caret marker, then 'Hint: {hint}' if present. Redact absolute paths unless debug mode. Per SPEC-010 Section 11.2 and REQ-106/REQ-107/REQ-116/REQ-117.")
  (phase "d3-cli-wiring")
  (target-file "crates/spindle-cli/src/error_report.rs")
  (implements "REQ-106 REQ-107 REQ-116 REQ-117 REQ-205")
  (effort "4h"))

(meta task-render-json
  (description "Implement render_json() on ErrorReport. Produces the contract-compliant JSON envelope with embedded ProblemDetails at error.details.problem. Ensures schema_version, diagnostics array, and error object are all present. Per SPEC-010 CON-103/REQ-205.")
  (phase "d3-cli-wiring")
  (target-file "crates/spindle-cli/src/error_report.rs")
  (implements "REQ-103 REQ-205")
  (effort "2h"))

(meta task-replace-cli-error
  (description "Replace ad-hoc CliError struct with ProblemDetails-based error flow. Update emit_and_exit to use ErrorReport for JSON and render_human for stderr. Convert all CliError::validation/parse/execution calls to construct ProblemDetails. Keep existing exit code semantics. Largest task - touches all error paths in CLI. Per SPEC-010 REQ-102/REQ-103/REQ-104/REQ-205.")
  (phase "d3-cli-wiring")
  (target-file "crates/spindle-cli/src/cli/error.rs crates/spindle-cli/src/cli/output.rs")
  (implements "REQ-102 REQ-103 REQ-104 REQ-205")
  (effort "6h"))

(meta task-debug-errors-flag
  (description "Add --debug-errors global CLI flag. When enabled, render_human includes full source() error chain and unredacted paths. Per SPEC-010 REQ-107 and Section 11.2.")
  (phase "d3-cli-wiring")
  (target-file "crates/spindle-cli/src/cli/app.rs")
  (implements "REQ-107")
  (effort "2h"))

(meta task-explain-code-flag
  (description "Add --explain CODE subcommand or flag. Prints expanded explanation for a stable error code: meaning, common causes, correct usage example, doc reference. Per SPEC-010 REQ-124 and Section 11.1 principle 13.")
  (phase "d3-cli-wiring")
  (target-file "crates/spindle-cli/src/cli/app.rs crates/spindle-cli/src/error_report.rs")
  (implements "REQ-124")
  (effort "4h"))

