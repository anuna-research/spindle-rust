; ===========================================================================
; Metadata: Phase A - Spec and Contract Hygiene
; ===========================================================================

(meta task-fix-contract-refs
  (description "Reconcile SPINDLE-CONTRACT.md references in specs. Verify specs/SPINDLE-CONTRACT.md exists and all cross-references in ERROR-MODULE-SPEC.md and SPINDLE-RUST-IMPLEMENTATION.md resolve correctly. Fix broken anchors like §8-error-and-exit-behavior-normative. Per OBS-206/ADR-205.")
  (phase "a-spec-hygiene")
  (target-file "specs/ERROR-MODULE-SPEC.md specs/SPINDLE-RUST-IMPLEMENTATION.md")
  (implements "REQ-201 REQ-207")
  (effort "1h"))

(meta task-fix-woodpecker-flags
  (description "Fix stale CI pipeline examples. .woodpecker/release.yaml line 198 uses '--format json' but CLI uses '--json'. Update to match actual CLI flags. Per OBS-206.")
  (phase "a-spec-hygiene")
  (target-file ".woodpecker/release.yaml")
  (implements "REQ-207")
  (effort "30m"))

(meta task-plan-contract-crate
  (description "Document the spindle-contract crate design: what shared transport types it will own (ReasonOutput, GroundingStats, ConclusionStruct, TheoryStats, error envelope types), its Cargo.toml shape, and dependency direction (CLI and WASM depend on it, it depends on spindle-core for Literal/Mode/Temporal types). Per ADR-201.")
  (phase "a-spec-hygiene")
  (target-file "specs/SPINDLE-CONTRACT-CRATE.md")
  (implements "REQ-203")
  (effort "2h"))

; ===========================================================================
; Metadata: Phase B - CLI Boundary Decomposition
; ===========================================================================

(meta task-cli-app-module
  (description "Extract CLI application scaffolding from main.rs into src/cli/app.rs: the Cli struct, Commands enum, and clap derive macros. Keep same flags and subcommands. No behavior change. Per REQ-202/OBS-203.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-cli/src/cli/app.rs")
  (implements "REQ-202")
  (effort "2h"))

(meta task-cli-input-module
  (description "Extract theory source resolution and loading from main.rs into src/cli/input.rs: TheorySource enum, resolve_theory_source(), load_theory_source(), load_theory_from_file(), load_theory_from_stdin(), parse_theory_content(), parse_literal_arg(). No behavior change. Per REQ-202.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-cli/src/cli/input.rs")
  (implements "REQ-202")
  (effort "2h"))

(meta task-cli-output-module
  (description "Extract output rendering from main.rs into src/cli/output.rs: CommandOutput enum, emit_and_exit() function, JSON serialization helpers, print_json_error_envelope(), print_non_json_error(). No behavior change. Per REQ-202.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-cli/src/cli/output.rs")
  (implements "REQ-202")
  (effort "2h"))

(meta task-cli-error-module
  (description "Extract error types from main.rs into src/cli/error.rs: CliError struct and its constructors (validation, parse, execution, resource, with_details), Diagnostic struct and constructors (warning, error, info). No behavior change. Per REQ-202.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-cli/src/cli/error.rs")
  (implements "REQ-202")
  (effort "1h"))

(meta task-cli-commands-module
  (description "Extract command implementations from main.rs into src/cli/commands/{reason,validate,stats,query,explain,why_not,requires,capabilities}.rs. Each command gets its own file with its output structs and run_* function. No behavior change. Per REQ-202/OBS-203.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-cli/src/cli/commands/")
  (implements "REQ-202")
  (effort "4h"))

(meta task-fix-double-prepare
  (description "Fix OBS-204: CLI run_reason calls prepare() then passes result.theory to reason() which calls prepare() again internally. Add reason_prepared() or equivalent that accepts a pre-prepared theory, or refactor reason() to skip prepare when theory is already ground. Per REQ-204/ADR-203/CON-203.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-core/src/reason.rs crates/spindle-cli/src/main.rs")
  (implements "REQ-204")
  (effort "3h"))

(meta task-cli-main-rewire
  (description "Rewire main.rs to import from extracted cli/ modules. main() stays thin: parse args, dispatch to command, emit output. Remove all moved code from main.rs. Verify cargo build succeeds. Per REQ-202.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-cli/src/main.rs")
  (implements "REQ-202")
  (effort "2h"))

(meta task-cli-behavior-parity
  (description "TEST-202: Run all existing CLI tests after module split. Add smoke tests for no-arg, --help, --version, and each subcommand. Assert identical stdout/stderr/exit-code behavior vs pre-split baseline. Per NFR-201.")
  (phase "b-cli-decomposition")
  (target-file "crates/spindle-cli/src/tests.rs")
  (verifies "TEST-202")
  (effort "2h"))

