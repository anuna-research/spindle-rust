(normally r-dep-cli-commands-on-phase-a
  (and task-cli-commands-module phase-a-complete)
  ready-cli-commands-module)

; Fix double prepare can happen in parallel with CLI decomposition
(normally r-dep-fix-double-prepare-on-phase-a
  (and task-fix-double-prepare phase-a-complete)
  ready-fix-double-prepare)

; Rewire main.rs to use the extracted modules
(normally r-dep-cli-main-rewire
  (and task-cli-main-rewire completed-cli-app-module completed-cli-input-module
       completed-cli-output-module completed-cli-error-module completed-cli-commands-module
       completed-fix-double-prepare)
  ready-cli-main-rewire)

; Behavior parity verification after full rewire
(normally r-dep-cli-behavior-parity
  (and task-cli-behavior-parity completed-cli-main-rewire)
  ready-cli-behavior-parity)

(normally r-phase-b-done
  (and completed-cli-app-module completed-cli-input-module completed-cli-output-module
       completed-cli-error-module completed-cli-commands-module completed-cli-main-rewire
       completed-cli-behavior-parity completed-fix-double-prepare)
  phase-b-complete)

