(given task-cli-input-module)
(given task-cli-output-module)
(given task-cli-error-module)
(given task-cli-commands-module)
(given task-cli-main-rewire)
(given task-cli-behavior-parity)
(given task-fix-double-prepare)

; CLI modules can be extracted in parallel after phase A
(normally r-dep-cli-app-on-phase-a
  (and task-cli-app-module phase-a-complete)
  ready-cli-app-module)

(normally r-dep-cli-input-on-phase-a
  (and task-cli-input-module phase-a-complete)
  ready-cli-input-module)

(normally r-dep-cli-output-on-phase-a
  (and task-cli-output-module phase-a-complete)
