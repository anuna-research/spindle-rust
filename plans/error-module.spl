(meta task-create-contract-crate
  (description "Create crates/spindle-contract with Cargo.toml (deps: serde, serde_json, spindle-core). Define shared transport types: ReasonOutput, GroundingStats, ConclusionStruct, TheoryStats, LiteralStructJson, ModeJson, TemporalJson and their From impls. Add to workspace Cargo.toml. Per ADR-201/REQ-203/CON-202.")
  (phase "c-contract-extraction")
  (target-file "crates/spindle-contract/src/lib.rs crates/spindle-contract/Cargo.toml Cargo.toml")
  (implements "REQ-203")
  (effort "4h"))

(meta task-migrate-cli-dtos
  (description "Replace duplicate DTO structs in spindle-cli with re-exports from spindle-contract. Remove ReasonOutput, GroundingStats, ConclusionStruct, TheoryStats, LiteralStructJson, ModeJson, TemporalJson from CLI code. Update imports in command modules. Per OBS-202/REQ-203.")
  (phase "c-contract-extraction")
  (target-file "crates/spindle-cli/Cargo.toml crates/spindle-cli/src/")
  (implements "REQ-203")
  (effort "2h"))

(meta task-migrate-wasm-dtos
  (description "Replace duplicate DTO structs in spindle-wasm with re-exports from spindle-contract. Remove JsReasonOutput, JsGroundingStats, JsConclusionStruct, JsTheoryStats and their From impls. Update imports. Per OBS-202/REQ-203.")
  (phase "c-contract-extraction")
  (target-file "crates/spindle-wasm/Cargo.toml crates/spindle-wasm/src/lib.rs")
  (implements "REQ-203")
  (effort "2h"))

(meta task-dto-parity-tests
  (description "TEST-203: Serialize identical theory outcomes through CLI and WASM paths, assert schema and value parity. Verify deterministic ordering preserved. Per NFR-202/CON-202.")
  (phase "c-contract-extraction")
  (target-file "crates/spindle-contract/tests/parity_tests.rs")
  (verifies "TEST-203")
  (effort "2h"))

; ===========================================================================
; Metadata: Phase D1 - Extend core error types
; ===========================================================================

(meta task-error-category
  (description "Define ErrorCategory enum in spindle-core/src/error.rs with variants: ParseError, ValidationError, ExecutionError, ResourceLimit, InternalError. Add default_title(), exit_code(), and default_hint() methods. Maps to SPEC-010 Section 10.1 taxonomy.")
  (phase "d1-core-types")
  (target-file "crates/spindle-core/src/error.rs")
  (implements "REQ-104 REQ-105 REQ-206")
  (effort "2h"))

(meta task-core-code-category
  (description "Add code() -> &'static str and category() -> ErrorCategory methods to SpindleError. Map each variant per SPEC-010 Section 10.2: RuleNotFound->RULE_NOT_FOUND/ExecutionError, InvalidLiteral->INVALID_LITERAL/ValidationError, TheoryError->THEORY_ERROR/ValidationError, ReasoningError->REASONING_ERROR/ExecutionError, Validation->VALIDATION_ERROR/ValidationError, Parse->delegates to inner ParseError.")
  (phase "d1-core-types")
  (target-file "crates/spindle-core/src/error.rs")
  (implements "REQ-105 REQ-109 REQ-206")
  (effort "2h"))

(meta task-parser-code-category
  (description "Add code() -> &'static str and category() -> ErrorCategory methods to ParseError. Map: LexerError->DFL_LEXER_ERROR/ParseError, ParserError->DFL_PARSE_ERROR/ParseError, UnexpectedToken->UNEXPECTED_TOKEN/ParseError, IoError->IO_ERROR/InternalError. Import ErrorCategory from spindle-core.")
  (phase "d1-core-types")
  (target-file "crates/spindle-parser/src/error.rs")
  (implements "REQ-105 REQ-109 REQ-206")
  (effort "2h"))

(meta task-non-exhaustive
  (description "Add #[non_exhaustive] attribute to both SpindleError and ParseError enums. Update any internal match arms to include wildcard _ where needed. Per SPEC-010 REQ-111/ADR-106.")
  (phase "d1-core-types")
  (target-file "crates/spindle-core/src/error.rs crates/spindle-parser/src/error.rs")
  (implements "REQ-111")
  (effort "1h"))

(meta task-from-parse-error
  (description "Add Parse(#[from] spindle_parser::ParseError) variant to SpindleError with #[error(transparent)] for Display/source() delegation. Per SPEC-010 ADR-107 composition pattern. Add spindle-parser as dependency of spindle-core if not already.")
  (phase "d1-core-types")
  (target-file "crates/spindle-core/src/error.rs crates/spindle-core/Cargo.toml")
  (implements "REQ-109 REQ-110")
  (effort "2h"))

(meta task-send-sync-static
  (description "Add compile-time assertion tests: fn assert_send_sync<T: Send + Sync + 'static>() {} called with SpindleError and ParseError. Verify all fields are owned (String, not &str). Per SPEC-010 REQ-112.")
  (phase "d1-core-types")
  (target-file "crates/spindle-core/src/error.rs")
  (implements "REQ-112")
  (effort "30m"))

