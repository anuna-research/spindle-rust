  ready-fix-contract-refs)

(normally r-ready-fix-woodpecker-flags
  (and task-fix-woodpecker-flags no-deps-fix-woodpecker-flags)
  ready-fix-woodpecker-flags)

(normally r-ready-plan-contract-crate
  (and task-plan-contract-crate no-deps-plan-contract-crate)
  ready-plan-contract-crate)

(normally r-phase-a-done
  (and completed-fix-contract-refs completed-fix-woodpecker-flags completed-plan-contract-crate)
  phase-a-complete)

