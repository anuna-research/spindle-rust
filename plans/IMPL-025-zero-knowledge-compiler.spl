(given (task-acceptance interfaces "TEST-006 through TEST-008 and TEST-011 through TEST-012: package and CLI acceptance cases pass"))
(normally r-ready-interfaces (and (task interfaces) (completed cryptography)) (ready interfaces))
(meta r-ready-interfaces (source "SPEC-025-zero-knowledge-compiler#REQ-005"))
(given (task acceptance))
