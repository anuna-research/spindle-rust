(given (task-acceptance acceptance "All SPEC-025 tests have recorded passing evidence; review findings are resolved and documentation matches behaviour"))
(normally r-ready-acceptance (and (task acceptance) (completed aggregates) (completed interfaces)) (ready acceptance))
(meta r-ready-acceptance (source "SPEC-025-zero-knowledge-compiler#REQ-001"))
