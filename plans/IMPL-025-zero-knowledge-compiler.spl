(predicate task-acceptance ((id symbol) (text symbol)) (kind state))
(given (task semantics))
(given (task-description semantics "Compile traditional four-tag inference into a bounded witness-independent constraint program"))
(given (task-acceptance semantics "TEST-001: all four tags match ground reference cases and generated theories"))
(given (no-deps semantics))
(normally r-ready-semantics (and (task semantics) (no-deps semantics)) (ready semantics))
(meta r-ready-semantics (source "SPEC-025-zero-knowledge-compiler#REQ-001"))
(given (task cryptography))
(given (task-description cryptography "Constrain inference and randomized commitments; authenticate claims with real proofs"))
(given (task-acceptance cryptography "TEST-002 through TEST-005: actual proofs pass and corrupted witnesses or statements fail"))
(normally r-ready-cryptography (and (task cryptography) (completed semantics)) (ready cryptography))
(meta r-ready-cryptography (source "SPEC-025-zero-knowledge-compiler#REQ-002"))
(given (task aggregates))
