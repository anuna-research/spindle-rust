(normally r-assign-rust-integration
  (and ready-rust-integration agent-writer-available)
  assign-to-rust-integration-writer)

(normally r-assign-summary
  (and ready-summary agent-writer-available)
  assign-to-summary-writer)

(normally r-assign-rebuild
  (and ready-rebuild agent-writer-available)
  assign-to-rebuild-writer)

