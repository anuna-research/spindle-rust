;; Plan: Update docs/book for v0.3.0
;; Based on gap analysis of main branch vs. current documentation

(meta plan
  (id "DOCS-030")
  (title "Update Documentation for v0.3.0")
  (version "1.0.0")
  (status "active")
  (created "2026-03-06")
  (author "agent:orchestrator")
  (description "Update docs/book/ to reflect SPEC-017 arithmetic, SPEC-018 temporal atom identity, pipeline architecture, requires v2, capabilities command, and v0.3.0 version bump"))

;; Agents — parallel writers for independent doc sections
(given agent-writer-available)

;; ─── Tasks ───────────────────────────────────────────────────────────

;; Phase 1: Critical updates (no dependencies)
(given task-temporal)
(given no-deps-temporal)
(given task-architecture)
(given no-deps-architecture)
(given task-cli)
(given no-deps-cli)
(given task-arithmetic)
(given no-deps-arithmetic)

;; Phase 2: Depends on understanding architecture + temporal
(given task-rust-integration)
(given task-changelog)
(given no-deps-changelog)

;; Phase 3: Final — rebuild book + update SUMMARY
(given task-summary)
(given task-rebuild)

;; ─── Task Metadata ───────────────────────────────────────────────────

(meta task-temporal
  (description "Update guides/temporal.md with SPEC-018 temporal atom identity, bridging rules, and temporal-aware query matching")
  (acceptance "Covers TemporalBridge synthetic rules, AtomKey identity fix, temporal-aware abduce/why_not, with examples"))

(meta task-architecture
  (description "Update internals/architecture.md with composable PipelineStage trait, TemporalBridge stage, pipeline builder, and current module layout")
  (acceptance "Pipeline section shows all stages including TemporalBridge; module map matches actual crate structure"))

(meta task-cli
  (description "Update reference/cli.md with --v2 flag, capabilities command, JSON schema versions (v1/v2), and requires v2 default behavior")
  (acceptance "All CLI subcommands documented including capabilities; --v2 semantics explained; JSON envelope versions listed"))

(meta task-arithmetic
  (description "Polish guides/arithmetic.md with Float vs Decimal distinction, error examples for restriction violations, and REQ cross-references")
  (acceptance "Explains when Float vs Decimal is used; shows error messages for head-arithmetic, negated-arithmetic, temporal-var violations"))

(meta task-rust-integration
  (description "Update integration/rust.md with PipelineBuilder examples, new Term/NumericValue types, and custom pipeline composition")
  (acceptance "Shows PipelineBuilder usage, Term enum with Integer/Decimal/Float, and at least one custom pipeline example"))

(meta task-changelog
  (description "Create a CHANGELOG section in README or docs covering 0.2.0 to 0.3.0 changes")
  (acceptance "Lists SPEC-017, SPEC-018, requires v2, temporal bridging, version bump with brief descriptions"))

(meta task-summary
  (description "Update docs/src/SUMMARY.md if any new pages were added")
  (acceptance "SUMMARY.md includes all doc pages that exist in docs/src/"))

(meta task-rebuild
  (description "Rebuild the mdbook output in docs/book/ from updated sources")
  (acceptance "mdbook build succeeds with no errors; docs/book/ contains updated HTML"))

;; ─── Readiness Rules ─────────────────────────────────────────────────

;; Phase 1: all independent, ready immediately
(normally r-ready-temporal
  (and task-temporal no-deps-temporal)
  ready-temporal)

(normally r-ready-architecture
  (and task-architecture no-deps-architecture)
  ready-architecture)

(normally r-ready-cli
  (and task-cli no-deps-cli)
  ready-cli)

(normally r-ready-arithmetic
  (and task-arithmetic no-deps-arithmetic)
  ready-arithmetic)

(normally r-ready-changelog
  (and task-changelog no-deps-changelog)
  ready-changelog)

;; Phase 2: rust-integration depends on architecture understanding
(normally r-ready-rust-integration
  (and task-rust-integration completed-architecture)
  ready-rust-integration)

;; Phase 3: summary depends on all content tasks
(normally r-ready-summary
  (and task-summary completed-temporal completed-architecture completed-cli completed-arithmetic completed-rust-integration completed-changelog)
  ready-summary)

;; Phase 3: rebuild depends on summary
(normally r-ready-rebuild
  (and task-rebuild completed-summary)
  ready-rebuild)

;; ─── Assignment Rules ────────────────────────────────────────────────

(normally r-assign-temporal
  (and ready-temporal agent-writer-available)
  assign-to-temporal-writer)

(normally r-assign-architecture
  (and ready-architecture agent-writer-available)
  assign-to-architecture-writer)

(normally r-assign-cli
  (and ready-cli agent-writer-available)
