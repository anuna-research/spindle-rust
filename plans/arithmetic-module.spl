  assign-to-tests-v2-json-testing)

;; ============================================================
;; RULE METADATA (justifications for key dependency decisions)
;; ============================================================

(meta r-ready-term-enum
  (description "Term enum requires rust_decimal crate")
  (justification "Term::Decimal wraps rust_decimal::Decimal"))

(meta r-ready-arith-ast
  (description "ArithExpr evaluates to NumericValue which maps to Term")
  (justification "ArithExpr::eval returns NumericValue; needs Term for type promotion"))

(meta r-ready-migrate-literal
  (description "Literal migration depends on Term enum being defined")
  (justification "predicate_ids: Vec<SymbolId> becomes predicate_args: Vec<Term>"))

(meta r-ready-migrate-substitution
  (description "Substitution migration depends on Literal migration")
  (justification "Substitution produces/consumes Term values that go into Literal predicate_args"))

(meta r-ready-migrate-rulebody
  (description "RuleBody migration depends on BodyLiteral and Literal migration")
  (justification "RuleBody changes from SmallVec<[Literal; 4]> to SmallVec<[BodyLiteral; 4]>"))

(meta r-ready-body-eval-order
  (description "Grounding body evaluation needs BodyLiteral enum, Substitution with Term, and ArithExpr evaluator")
  (justification "Source-order evaluation dispatches on BodyLiteral::Logic vs ::Arithmetic and calls ArithExpr::eval/ArithConstraint::eval"))

(meta r-ready-parse-guards
  (description "Parse guards depend on all parser components being in place")
  (justification "Guards check for arithmetic in heads, negation of arithmetic, and reserved keywords — all parser features must exist first"))

(meta r-ready-tests-grounding
  (description "Grounding tests need full pipeline: parser + grounding + reasoning")
  (justification "End-to-end tests parse SPL, ground with arithmetic, reason, and check conclusions"))

