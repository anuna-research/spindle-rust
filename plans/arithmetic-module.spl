  (and ready-arith-ast agent-core-available)
  assign-to-arith-ast-core)

(normally r-assign-body-literal
  (and ready-body-literal agent-core-available)
  assign-to-body-literal-core)

(normally r-assign-migrate-literal
  (and ready-migrate-literal agent-core-available)
  assign-to-migrate-literal-core)

