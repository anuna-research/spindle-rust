; SPEC-017: Arithmetic Module Implementation Plan
; Adds built-in arithmetic to SPL: numeric terms (Integer/Decimal/Float),
; arithmetic expressions in Polish notation, bind/comparison predicates,
; type promotion, and cross-type numeric matching.
;
; Architecture: Five-phase implementation following the spec's guidance:
;   Phase 1 — Core Term Type (spindle-core types + evaluation)
;   Phase 2 — Parser Extension (spindle-parser lexer + arithmetic parsing)
;   Phase 3 — Grounding Integration (body evaluation + cross-type matching)
;   Phase 4 — Tests (unit, integration, property-based)
;   Phase 5 — Contract and CLI Output (v2 JSON serialization)
;
; Key files affected:
;   spindle-core: literal.rs, grounding.rs, rule.rs, Cargo.toml + new term.rs, arith.rs
;   spindle-parser: spl/lexer.rs, spl/literals.rs + new spl/arith.rs
;   spindle-cli: output serialization
;   spindle-wasm: output serialization

(meta plan
  (id "IMPL-017")
  (title "SPEC-017 Arithmetic Module")
  (version "1.0.0")
  (status "active")
  (created "2026-02-25")
  (author "agent:architect")
  (spec "SPEC-017")
  (description "Implement built-in arithmetic for SPL: numeric terms, Polish-notation expressions, bind/comparison predicates, type promotion, and v2 JSON contracts"))

;; ============================================================
;; AGENTS
;; ============================================================

(given agent-core-available)
(given agent-parser-available)
(given agent-grounding-available)
(given agent-testing-available)
(given agent-contracts-available)

;; ============================================================
;; PHASE 1: CORE TERM TYPE (spindle-core)
;; REQ-001, REQ-002, REQ-005, ADR-002, CON-001, CON-002
;; ============================================================

;; --- Task 1.1: Add rust_decimal dependency ---

(given task-add-rust-decimal)
(given no-deps-add-rust-decimal)
(meta task-add-rust-decimal
  (description "Add rust_decimal = '1.x' to spindle-core/Cargo.toml [dependencies] and workspace Cargo.toml [workspace.dependencies]. Verify `cargo check` passes.")
  (acceptance "rust_decimal appears in Cargo.toml, cargo check succeeds, no other changes")
  (phase "1-core")
  (spec-ref "ADR-002")
  (file "crates/spindle-core/Cargo.toml"))

;; --- Task 1.2: Implement Term enum ---

(given task-term-enum)
(meta task-term-enum
  (description "Create crates/spindle-core/src/term.rs with Term enum: Symbol(SymbolId), Integer(i64), Decimal(rust_decimal::Decimal), Float(f64). Implement Display, Clone, Debug. For Float variant, implement a canonicalized finite-float wrapper (or OrderedFloat equivalent) that normalizes -0.0 to 0.0 and rejects NaN/Inf, with stable Eq+Hash. Add Term::is_numeric(), Term::numeric_eq() with cross-type promotion (REQ-005). Add NumericValue enum (Integer/Decimal/Float) for arithmetic expression evaluation results that converts to/from Term.")
  (acceptance "Term enum compiles with Eq, Hash, Clone, Debug, Display. Float hashing is deterministic. Unit tests for equality: Integer(0) != Symbol('0'), Float(-0.0) == Float(0.0), NaN rejected. Cross-type numeric_eq: Integer(8) matches Decimal(8.00)")
  (phase "1-core")
  (spec-ref "ADR-002, REQ-001, REQ-005, REQ-010")
  (file "crates/spindle-core/src/term.rs"))

;; --- Task 1.3: Implement ArithExpr and ArithConstraint ---

(given task-arith-ast)
(meta task-arith-ast
  (description "Create crates/spindle-core/src/arith.rs with: ArithExpr enum (Lit, Var, NaryOp, BinOp, UnaryOp), NaryArithOp (Add, Sub, Mul, Div, Min, Max), BinArithOp (IDiv, Rem, Pow), UnaryArithOp (Abs), CmpOp (Eq, Ne, Lt, Gt, Le, Ge), ArithConstraint (Bind{var, expr}, Compare{op, lhs, rhs}), ArithError enum (DivisionByZero, IntegerOverflow, DecimalOverflow, UnboundVariable, TypeMismatch, NonFiniteFloat, ReciprocalOfZero, ComparisonFailed). Implement ArithExpr::eval(&self, subst: &Substitution) -> Result<NumericValue, ArithError> with: checked integer arithmetic, rust_decimal for decimal ops, f64 for float ops, promotion rules per REQ-005 (Integer+Decimal->Decimal, any+Float->Float, Integer/Integer->Decimal for division). Implement variadic semantics per CON-002 (identity elements, left-fold, unary negation/reciprocal). Implement ArithConstraint::eval(&self, subst: &mut Substitution) -> Result<(), ArithError>.")
  (acceptance "All ArithExpr variants evaluate correctly. Checked integer overflow returns IntegerOverflow. Division by zero returns DivisionByZero. Type promotion matches REQ-005 exactly. Variadic +/* with 0 args return identity. Unary - negates, unary / gives reciprocal. div/rem reject non-integers. ** handles all exponentiation cases from REQ-005. Unit tests for every ArithError variant.")
  (phase "1-core")
  (spec-ref "CON-002, CON-003, CON-004, REQ-002, REQ-003, REQ-004, REQ-005")
  (file "crates/spindle-core/src/arith.rs"))

;; --- Task 1.4: Implement BodyLiteral enum and BodyArg ---

(given task-body-literal)
(meta task-body-literal
  (description "Add BodyLiteral, BodyLogicLiteral, and BodyArg types per SPEC-017 section 7.4. BodyArg::Term(Term) for concrete args, BodyArg::Arith(ArithExpr) for expression args. BodyLogicLiteral mirrors Literal fields but uses Vec<BodyArg> for predicate_args. BodyLiteral::Logic(BodyLogicLiteral) for fact-matching, BodyLiteral::Arithmetic(ArithConstraint) for bind/compare. Place in a new crates/spindle-core/src/body.rs or extend rule.rs. NOTE: ArithConstraint has no negation flag (REQ-011 makes negation of arithmetic a parse error).")
  (acceptance "BodyLiteral enum compiles. Can construct BodyLiteral::Logic with BodyArg::Arith arguments. Can construct BodyLiteral::Arithmetic with Bind and Compare variants. No negation field on ArithConstraint.")
  (phase "1-core")
  (spec-ref "Section 7.4, REQ-011")
  (file "crates/spindle-core/src/body.rs"))

;; --- Task 1.5: Migrate Literal predicate_ids to Vec<Term> ---

(given task-migrate-literal)
(meta task-migrate-literal
  (description "Change Literal::predicate_ids from Vec<SymbolId> to predicate_args: Vec<Term>. Update all accessor methods (predicate_ids() -> &[Term], predicates(), from_ids(), new()). Update Eq/Hash impls to work with Term. Update all call sites across spindle-core that destructure predicate_ids — primarily grounding.rs match_literal, apply_substitution_to_literal, pipeline.rs, reason.rs, scalable.rs, query.rs, explain.rs, index.rs. Existing code should construct Term::Symbol(id) where it previously used bare SymbolId. This is the highest-risk change — audit every match arm.")
  (acceptance "All existing tests pass. cargo test --all succeeds. Literal stores Vec<Term>. All callers updated. No regressions in reasoning output.")
  (phase "1-core")
  (spec-ref "ADR-002, Section 7.1")
  (file "crates/spindle-core/src/literal.rs")
  (risk "high — breaking change touching every module that handles literals"))

;; --- Task 1.6: Migrate Substitution terms to FxHashMap<SymbolId, Term> ---

(given task-migrate-substitution)
(meta task-migrate-substitution
  (description "Change Substitution::terms from FxHashMap<SymbolId, SymbolId> to FxHashMap<SymbolId, Term>. Update match_literal to produce Term values in substitution. Update apply_substitution_to_literal to read Term values and place them in predicate_args. Update merge_substitutions to handle Term equality (use Term::Eq, which handles canonical float). Existing symbol bindings become Term::Symbol(id). All grounding.rs functions that read/write substitution.terms must be updated.")
  (acceptance "All existing tests pass. Substitution stores Term values. Grounding produces correct results for non-arithmetic theories (regression check).")
  (phase "1-core")
  (spec-ref "Section 7.2")
  (file "crates/spindle-core/src/grounding.rs")
  (risk "high — coupled with task-migrate-literal"))

;; --- Task 1.7: Update RuleBody to use BodyLiteral ---

(given task-migrate-rulebody)
(meta task-migrate-rulebody
  (description "Change RuleBody type alias from SmallVec<[Literal; 4]> to SmallVec<[BodyLiteral; 4]>. All code that constructs or iterates RuleBody must handle the BodyLiteral enum. For non-arithmetic rules, all body literals are BodyLiteral::Logic. Existing test fixtures and parser output must wrap Literals in BodyLiteral::Logic. The grounding loop (match_body_against_facts, match_body_with_delta) must dispatch on BodyLiteral variant.")
  (acceptance "All existing tests pass. RuleBody contains BodyLiteral values. Non-arithmetic rules produce BodyLiteral::Logic wrappers. Grounding dispatches correctly.")
  (phase "1-core")
  (spec-ref "Section 7.4")
  (file "crates/spindle-core/src/rule.rs")
  (risk "medium — broad change but mechanical"))

