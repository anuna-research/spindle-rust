;; ============================================================
;; PHASE 5: CONTRACT AND CLI OUTPUT (REQ-012, CON-006)
;; ============================================================

;; --- Task 5.1: v2 JSON schema with typed arguments ---

(given task-v2-json-schema)
(meta task-v2-json-schema
  (description "Add v2 JSON contract schema types and serialization for Term. Term::Symbol -> {type: 'symbol', value: str}. Term::Integer -> {type: 'integer', value: number} (string if >2^53). Term::Decimal -> {type: 'decimal', value: str} (always string to preserve scale). Term::Float -> {type: 'float', value: number}. Add serde Serialize/Deserialize for v2 TermDto. v1 schemas unchanged (all args as strings). Add schema version negotiation or explicit v2 output flag.")
  (acceptance "v2 JSON output for mixed args [Symbol('widget'), Integer(25), Decimal(0.08)] serializes correctly. Integer >2^53 uses string. Decimal preserves trailing zeros ('8.00'). Round-trip: serialize then deserialize produces identical Term values. v1 output unchanged for same theory.")
  (phase "5-contracts")
  (spec-ref "REQ-012, CON-006")
  (file "crates/spindle-core/src/contracts/"))

;; --- Task 5.2: CLI and WASM v2 output integration ---

(given task-v2-cli-wasm)
(meta task-v2-cli-wasm
  (description "Update spindle-cli and spindle-wasm to support v2 JSON output. Add --v2 flag or similar for CLI. WASM API gets v2 output methods. Ensure backward compatibility: default output remains v1. v2 is opt-in. Update CLI text output to display numeric terms naturally (Integer as-is, Decimal with rust_decimal Display preserving trailing zeros, Float with standard f64 display).")
  (acceptance "CLI --v2 flag produces v2 JSON. Default output is v1. WASM v2 methods return typed JSON. CLI text shows 'total(order-001, 108.00)' with decimal scale preserved.")
  (phase "5-contracts")
  (spec-ref "REQ-012")
  (file "crates/spindle-cli/src/, crates/spindle-wasm/src/"))

;; --- Task 5.3: v2 JSON tests ---

(given task-tests-v2-json)
(meta task-tests-v2-json
  (description "Implement TEST-012 (v2 JSON typed argument serialization — all 8 scenarios). Verify round-trip for all Term variants, large integer string serialization, decimal string preservation, v1 compatibility. Place in crates/spindle-core/tests/json_v2.rs or contracts test module.")
  (acceptance "All 8 TEST-012 scenarios pass. v1 output for same theory is byte-identical to pre-arithmetic v1 output.")
  (phase "5-contracts")
  (spec-ref "TEST-012"))

;; Phase 5 dependency chain
(normally r-ready-v2-json-schema
  (and task-v2-json-schema completed-term-enum completed-tests-grounding)
  ready-v2-json-schema)

(normally r-ready-v2-cli-wasm
