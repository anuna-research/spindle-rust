  (and ready-migrate-rulebody agent-core-available)
  assign-to-migrate-rulebody-core)

;; ============================================================
;; PHASE 2: PARSER EXTENSION (spindle-parser)
;; REQ-001, REQ-002, REQ-003, REQ-004, REQ-008, REQ-009, REQ-011, ADR-003
;; ============================================================

;; --- Task 2.1: Extend lexer for arithmetic operator tokens ---

(given task-extend-lexer)
(meta task-extend-lexer
  (description "Extend spl/lexer.rs parse_atom to accept *, /, <, >, =, ! as atom characters so that operator tokens (*, /, <=, >=, !=, **) lex as atoms. Currently parse_atom accepts alphanumeric, -, _, ?, ~, :, ., +. Add the missing characters. Verify that multi-char atoms containing these chars (e.g. high-earner, c++test) still lex correctly — reservation applies only to standalone tokens, not substrings.")
  (acceptance "Tokens *, /, <=, >=, !=, **, div, rem, abs, min, max, bind all lex as SExpr::Atom. Existing atoms like 'high-earner' unaffected. Roundtrip: lex then check value.")
  (phase "2-parser")
  (spec-ref "ADR-003")
  (file "crates/spindle-parser/src/spl/lexer.rs"))

;; --- Task 2.2: Parse numeric literals in argument positions ---

(given task-parse-numeric-literals)
(meta task-parse-numeric-literals
  (description "Extend spl/literals.rs to detect and parse numeric literals in predicate argument positions. When an atom matches integer pattern (-?[0-9]+), parse as Term::Integer(i64). When it matches decimal pattern (-?[0-9]+.[0-9]+), parse as Term::Decimal. When it matches float pattern (-?[0-9]+(.[0-9]+)?[eE]-?[0-9]+), parse as Term::Float(f64). Out-of-range values produce ParseError with source offset. Order of detection: float (has e/E) > decimal (has .) > integer.")
  (acceptance "Integer: '42' -> Term::Integer(42). Decimal: '0.08' -> Term::Decimal(0.08) exact. Float: '1.5e3' -> Term::Float(1500.0). Negative: '-100' -> Term::Integer(-100). Overflow i64 -> ParseError. Exceeds 29 significant digits -> ParseError. Non-finite float -> ParseError.")
  (phase "2-parser")
  (spec-ref "REQ-001, CON-001")
  (file "crates/spindle-parser/src/spl/literals.rs"))

;; --- Task 2.3: Parse arithmetic expressions ---

(given task-parse-arith-expr)
(meta task-parse-arith-expr
  (description "Create crates/spindle-parser/src/spl/arith.rs. When the parser encounters an S-expression whose first atom is a reserved arithmetic operator (+, -, *, /, div, rem, abs, min, max, **) in an argument position, parse recursively as ArithExpr. Enforce arity constraints: + and * accept 0+ args, - and / accept 1+ args, min and max accept 1+ args, div/rem/** accept exactly 2, abs accepts exactly 1. Return ArithExpr::NaryOp, BinOp, or UnaryOp accordingly. Wrong arity -> ParseError.")
  (acceptance "All examples from CON-002 parse correctly. (+ ?x ?y ?z) -> NaryOp(Add, 3 args). (- ?x) -> NaryOp(Sub, 1 arg) = negation. (/ ?x) -> NaryOp(Div, 1 arg) = reciprocal. (div 10 3 2) -> ParseError. Nested: (* (+ ?a ?b) 2) -> nested ArithExpr.")
  (phase "2-parser")
  (spec-ref "REQ-002, CON-002")
  (file "crates/spindle-parser/src/spl/arith.rs"))

;; --- Task 2.4: Parse bind and comparison predicates ---

(given task-parse-bind-compare)
(meta task-parse-bind-compare
  (description "Extend the body-literal parsing in spl/literals.rs (or spl/arith.rs) to recognize (bind ?var expr) and (<cmp> expr1 expr2) where <cmp> is =, !=, <, >, <=, >= in body position. Produce BodyLiteral::Arithmetic(ArithConstraint::Bind{..}) and BodyLiteral::Arithmetic(ArithConstraint::Compare{..}). bind's first arg must be a ?-variable (else ParseError). bind's second arg must be a valid arith-expr (else ParseError).")
  (acceptance "(bind ?x (+ 1 2)) -> ArithConstraint::Bind with var and expr. (> ?amount 100000) -> ArithConstraint::Compare(Gt, ...). (bind 5 (+ 2 3)) -> ParseError. All six comparison operators parse correctly.")
  (phase "2-parser")
  (spec-ref "REQ-003, REQ-004, CON-003, CON-004")
  (file "crates/spindle-parser/src/spl/literals.rs"))

;; --- Task 2.5: Parse arithmetic expressions in body literal arguments ---

(given task-parse-body-arith-args)
(meta task-parse-body-arith-args
  (description "When parsing a user-defined body literal like (line-total ?i (* ?p 2)), detect arithmetic expressions in argument positions and produce BodyArg::Arith(ArithExpr) instead of BodyArg::Term. This requires the parser to check if an argument is an S-expression starting with an arithmetic operator. If so, recursively parse as ArithExpr via the arith parser from task 2.3.")
  (acceptance "(normally r1 (and (price ?i ?p) (line-total ?i (* ?p 2))) (ok ?i)) parses with line-total having BodyArg::Arith for the second argument. Plain arguments remain BodyArg::Term.")
  (phase "2-parser")
  (spec-ref "REQ-002, ADR-001b, Section 7.4")
  (file "crates/spindle-parser/src/spl/literals.rs"))

;; --- Task 2.6: Parse-time guards (head prohibition, negation, reserved keywords) ---

(given task-parse-guards)
(meta task-parse-guards
  (description "Add parse-time error checks: (1) Arithmetic predicates (bind, =, !=, <, >, <=, >=) in rule head position -> ParseError per REQ-009. (2) Arithmetic expressions as arguments in rule heads or facts -> ParseError per REQ-009. (3) Negation of arithmetic predicates (not (> ...) or ~(> ...)) -> ParseError per REQ-011. (4) Reserved keywords (+, -, *, /, div, rem, abs, min, max, **, bind, =, !=, <, >, <=, >=) as predicate names or rule labels -> ParseError per REQ-008. (5) Future-reserved keywords (sum, count, avg, round, floor, ceil) as predicate names or rule labels -> ParseError per REQ-008. (6) Reserved keywords in (prefer ...) declarations -> ParseError.")
  (acceptance "(normally r1 body (bind ?x 5)) -> ParseError. (given (cost (+ 3 4))) -> ParseError. (not (> ?x 100)) in body -> ParseError. (normally + body head) -> ParseError. (given (sum report 100)) -> ParseError. (prefer r1 bind) -> ParseError. (prefer r1 count) -> ParseError.")
  (phase "2-parser")
  (spec-ref "REQ-008, REQ-009, REQ-011")
  (file "crates/spindle-parser/src/spl/expressions.rs"))

;; Phase 2 dependency chain
(normally r-ready-extend-lexer
  (and task-extend-lexer completed-migrate-rulebody)
  ready-extend-lexer)

(normally r-ready-parse-numeric-literals
  (and task-parse-numeric-literals completed-extend-lexer completed-migrate-literal)
  ready-parse-numeric-literals)

(normally r-ready-parse-arith-expr
  (and task-parse-arith-expr completed-extend-lexer completed-arith-ast)
  ready-parse-arith-expr)

(normally r-ready-parse-bind-compare
  (and task-parse-bind-compare completed-parse-arith-expr completed-body-literal)
  ready-parse-bind-compare)

(normally r-ready-parse-body-arith-args
  (and task-parse-body-arith-args completed-parse-arith-expr completed-body-literal)
  ready-parse-body-arith-args)

(normally r-ready-parse-guards
  (and task-parse-guards completed-parse-bind-compare completed-parse-body-arith-args)
  ready-parse-guards)

;; Phase 2 assignments
(normally r-assign-extend-lexer
  (and ready-extend-lexer agent-parser-available)
  assign-to-extend-lexer-parser)

(normally r-assign-parse-numeric-literals
  (and ready-parse-numeric-literals agent-parser-available)
  assign-to-parse-numeric-literals-parser)

(normally r-assign-parse-arith-expr
  (and ready-parse-arith-expr agent-parser-available)
  assign-to-parse-arith-expr-parser)

(normally r-assign-parse-bind-compare
  (and ready-parse-bind-compare agent-parser-available)
  assign-to-parse-bind-compare-parser)

(normally r-assign-parse-body-arith-args
  (and ready-parse-body-arith-args agent-parser-available)
  assign-to-parse-body-arith-args-parser)

(normally r-assign-parse-guards
  (and ready-parse-guards agent-parser-available)
  assign-to-parse-guards-parser)

;; ============================================================
;; PHASE 3: GROUNDING INTEGRATION (spindle-core)
;; REQ-010, ADR-001, ADR-001b, CON-005
;; ============================================================

;; --- Task 3.1: Cross-type numeric matching in match_literal ---

(given task-cross-type-matching)
(meta task-cross-type-matching
  (description "Extend grounding.rs match_literal to handle cross-type numeric matching per REQ-010/CON-005. When a bound variable holds a numeric Term and a candidate fact argument is a different numeric Term type, promote both to a common type using REQ-005 rules and compare for equality. Integer(100) matches Decimal(100.00), Integer(100) matches Float(100.0), Decimal(100.00) matches Float(100.0). Symbol never matches numeric. Use Term::numeric_eq() from task 1.2.")
  (acceptance "Grounding matches Integer fact arg against Decimal substitution value when numerically equal. Does not match when unequal. Symbol(\"100\") does not match Integer(100). All TEST-010 scenarios pass.")
  (phase "3-grounding")
  (spec-ref "REQ-010, CON-005")
  (file "crates/spindle-core/src/grounding.rs"))

;; --- Task 3.2: Source-order body evaluation with arithmetic dispatch ---

(given task-body-eval-order)
(meta task-body-eval-order
  (description "Refactor the grounding loop (match_body_against_facts / match_body_with_delta) to evaluate BodyLiteral elements in source order, threading substitutions. For each body element: (1) BodyLiteral::Logic — evaluate any BodyArg::Arith arguments under current substitution (call ArithExpr::eval), replace with resulting Term, then match against facts. If ArithExpr::eval fails, discard substitution path. (2) BodyLiteral::Arithmetic — call ArithConstraint::eval on current substitution. Bind extends substitution, Compare filters. On failure, discard substitution path. Each step sees bindings from all preceding steps (ADR-001b).")
  (acceptance "Rule (and (price ?i ?p) (bind ?tax (* ?p 0.08)) (> ?tax 5)) fires correctly when price > 62.50. Reversed order (and (> ?tax 5) (bind ?tax ...)) fails because ?tax is unbound. Chained binds work: (and (bind ?a (+ 1 2)) (bind ?b (* ?a 3))) -> ?b = 9. BodyArg::Arith in logic literal evaluated before matching.")
  (phase "3-grounding")
  (spec-ref "ADR-001, ADR-001b")
  (file "crates/spindle-core/src/grounding.rs"))

;; --- Task 3.3: Propagate Term values through apply_substitution ---

(given task-propagate-terms)
(meta task-propagate-terms
  (description "Update apply_substitution_to_literal and apply_substitution_to_rule to propagate Term::Integer, Term::Decimal, Term::Float values from the substitution into ground literals. After grounding, rule heads should contain only concrete Term values (Symbol, Integer, Decimal, Float) — no ArithExpr. The head is still a regular Literal with Vec<Term> predicate_args. Ensure ground rules added back to the theory as new facts have correct Term-based predicate_args.")
  (acceptance "After grounding a rule with (bind ?total (* ?p ?q)), the head literal contains Term::Integer or Term::Decimal for ?total, not a symbol string of the number. New ground facts are indexed correctly by the fact index (name, negation, arity, mode).")
  (phase "3-grounding")
  (spec-ref "Section 7.3")
  (file "crates/spindle-core/src/grounding.rs"))

;; --- Task 3.4: Temporal variable guard ---

(given task-temporal-guard)
(meta task-temporal-guard
  (description "Ensure that temporal endpoint variables (?start, ?end from 'during' literals) and interval variables (?T) cannot be used as arithmetic operands. In ArithExpr::eval, if a variable resolves to a temporal binding (found in subst.temporal or subst.intervals but not in subst.terms), return ArithError::TypeMismatch. This causes silent failure per REQ-006.")
  (acceptance "Rule body with (during (salary ?emp ?amt) ?s ?e) and (+ ?s 1) in arithmetic position — the arithmetic literal fails silently. Rule body with (> ?amt 100000) where ?amt is bound via terms (not temporal) works correctly.")
  (phase "3-grounding")
  (spec-ref "REQ-006")
  (file "crates/spindle-core/src/arith.rs"))

;; Phase 3 dependency chain
(normally r-ready-cross-type-matching
  (and task-cross-type-matching completed-migrate-substitution completed-migrate-literal)
  ready-cross-type-matching)

(normally r-ready-body-eval-order
  (and task-body-eval-order completed-migrate-rulebody completed-migrate-substitution completed-arith-ast)
  ready-body-eval-order)

(normally r-ready-propagate-terms
  (and task-propagate-terms completed-body-eval-order completed-cross-type-matching)
  ready-propagate-terms)

(normally r-ready-temporal-guard
  (and task-temporal-guard completed-arith-ast completed-migrate-substitution)
  ready-temporal-guard)

;; Phase 3 assignments
(normally r-assign-cross-type-matching
  (and ready-cross-type-matching agent-grounding-available)
  assign-to-cross-type-matching-grounding)

(normally r-assign-body-eval-order
  (and ready-body-eval-order agent-grounding-available)
  assign-to-body-eval-order-grounding)

(normally r-assign-propagate-terms
  (and ready-propagate-terms agent-grounding-available)
  assign-to-propagate-terms-grounding)

(normally r-assign-temporal-guard
  (and ready-temporal-guard agent-grounding-available)
  assign-to-temporal-guard-grounding)

;; ============================================================
;; PHASE 4: TESTS
;; TEST-001 through TEST-012, TEST-NFR-001/002, TEST-PBT-001
;; ============================================================

;; --- Task 4.1: Unit tests for Term and ArithExpr ---

(given task-tests-term-arith)
(meta task-tests-term-arith
  (description "Write unit tests in spindle-core for: TEST-001 (numeric literal terms — all 10 scenarios), TEST-002 (arithmetic expression parsing — all 12 scenarios, evaluation side), TEST-005 (numeric type promotion — all 22 scenarios). Place in crates/spindle-core/src/term.rs #[cfg(test)] and crates/spindle-core/src/arith.rs #[cfg(test)].")
  (acceptance "All TEST-001, TEST-002 evaluation scenarios, and TEST-005 scenarios pass. Covers identity elements, left-fold, unary ops, div/rem integer-only enforcement, ** all cases.")
  (phase "4-tests")
  (spec-ref "TEST-001, TEST-002, TEST-005"))

;; --- Task 4.2: Parser integration tests ---

(given task-tests-parser)
(meta task-tests-parser
  (description "Write integration tests in spindle-parser for: TEST-002 (parsing side — all 12 scenarios), TEST-008 (reserved keyword enforcement — all 8 scenarios), TEST-009 (no arithmetic in heads — all 3 scenarios), TEST-011 (no negation of arithmetic — all 5 scenarios). Place in crates/spindle-parser/tests/ or src/spl/ test modules.")
  (acceptance "All TEST-002 parse scenarios, TEST-008, TEST-009, TEST-011 scenarios pass. Parse errors have correct error messages and source positions.")
  (phase "4-tests")
  (spec-ref "TEST-002, TEST-008, TEST-009, TEST-011"))

;; --- Task 4.3: Grounding integration tests ---

(given task-tests-grounding)
(meta task-tests-grounding
  (description "Write integration tests for: TEST-003 (bind predicate — all 7 scenarios), TEST-004 (comparison predicates — all 10 scenarios including order-dependent), TEST-006 (arithmetic in temporal rules — both scenarios), TEST-007 (arithmetic predicates not in superiority — both scenarios), TEST-010 (cross-type matching — all 6 unit + end-to-end scenario). These are end-to-end: parse SPL -> ground -> reason -> check conclusions. Place in crates/spindle-core/tests/arithmetic.rs.")
  (acceptance "All TEST-003, TEST-004, TEST-006, TEST-007, TEST-010 scenarios pass. Order-dependent test (TEST-004 scenarios 9-10) verifies source-order evaluation. Cross-type matching end-to-end from TEST-010 works.")
  (phase "4-tests")
  (spec-ref "TEST-003, TEST-004, TEST-006, TEST-007, TEST-010"))

;; --- Task 4.4: Worked examples as integration tests ---

(given task-tests-worked-examples)
(meta task-tests-worked-examples
  (description "Implement the four worked examples from Section 9 as integration tests: 9.1 Order Total with Tax, 9.2 Defeasible Classification with Override, 9.3 Temporal Arithmetic (Salary Bands Over Time), 9.4 Decimal Precision and Rounding. Each test parses the SPL, runs the full pipeline, and checks expected conclusions exactly.")
  (acceptance "All four worked examples produce the exact conclusions listed in the spec. Decimal precision is exact (0.3, not 0.30000000000000004). Tax calculation produces Decimal(8.00) not Float. Temporal example only derives senior-earner for the 110000 period.")
  (phase "4-tests")
  (spec-ref "Section 9"))

;; --- Task 4.5: NFR tests (overflow safety + performance) ---

(given task-tests-nfr)
(meta task-tests-nfr
  (description "Implement TEST-NFR-002 (integer overflow safety — 3 scenarios: add, mul, sub at i64 boundary, no panic). Implement TEST-NFR-001 (grounding performance regression — generate 500-fact/200-rule theory with arithmetic vs equivalent without, compare median grounding time, warn if >10% overhead). NFR-003 (no unsafe) verified by cargo clippy or grep.")
  (acceptance "Overflow tests pass without panic. Performance benchmark runs (warning-only, not hard fail). No unsafe blocks in arith.rs or term.rs.")
  (phase "4-tests")
  (spec-ref "TEST-NFR-001, TEST-NFR-002, NFR-003"))

;; --- Task 4.6: Property-based tests ---

(given task-tests-pbt)
(meta task-tests-pbt
  (description "Implement TEST-PBT-001 with proptest. Generators: bounded-depth ArithExpr (max depth 4), random NumericValue (Integer, Decimal, finite Float), random Substitution, random rule-body fragments. Properties: (1) determinism, (2) panic safety, (3) promotion correctness, (4) div/rem identity a = b*div(a,b)+rem(a,b), (5) floor remainder sign rule, (6) comparison reflexivity, (7) float safety, (8) source-order dependency, (9) body-arg expression equivalence, (10) parser round-trip stability.")
  (acceptance "proptest runs 500+ cases per property without failure. All 10 properties hold. No panics on any generated input.")
  (phase "4-tests")
  (spec-ref "TEST-PBT-001"))

