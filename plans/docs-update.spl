; Docs Update Plan v2 — Post DFL-removal & trust-parity cleanup
;
; Recent commits requiring doc updates:
;   - 0e1b9f2: refactor: remove dfl support and enforce spl-only input
;   - 2506b0c: Remove scalable reasoner and consolidate on standard DL(d)
;   - d332ca6: feat/trust-parity merge (weakest-link, decay, mining metrics)
;
; All DFL syntax/references must be removed from docs.
; Duplicate/stale parser references (dfl.rs) must be cleaned up.

; ── state ────────────────────────────────────────────────────────
(given docs_reviewed)

; ── t1: trust guide — remove DFL directives section ──────────────
(normally t1 docs_reviewed update_trust_guide)
(meta t1
  (description "Remove DFL trust directives section (lines 225-270) and DFL CLI example (lines 736-751) from guides/trust.md")
  (agent "claude")
  (file "docs/src/guides/trust.md"))

; ── t2: getting-started — convert DFL examples to SPL ────────────
(normally t2 docs_reviewed update_getting_started)
(meta t2
  (description "Convert DFL syntax examples to SPL in getting-started.md. Remove the separate 'Using SPL Format' section since SPL is now the only format")
  (agent "claude")
  (file "docs/src/getting-started.md"))

; ── t3: README — fix two-format references ───────────────────────
(normally t3 docs_reviewed update_readme)
(meta t3
  (description "Fix README.md: convert DFL example to SPL, change 'Two input formats' to SPL-only")
  (agent "claude")
  (file "docs/src/README.md"))

; ── t4: SPL reference — remove broken comparison table ───────────
(normally t4 docs_reviewed update_spl_reference)
(meta t4
  (description "Remove the 'SPL Comparison' table (lines 267-278) from reference/spl.md — it compared DFL vs SPL but DFL no longer exists")
  (agent "claude")
  (file "docs/src/reference/spl.md"))

; ── t5: CLI reference — fix duplicate format table ───────────────
(normally t5 docs_reviewed update_cli_reference)
(meta t5
  (description "Fix file format detection table in reference/cli.md — lists .spl twice (was .dfl and .spl). Remove duplicate row")
  (agent "claude")
  (file "docs/src/reference/cli.md"))

; ── t6: architecture — fix parser references ─────────────────────
(normally t6 docs_reviewed update_architecture)
(meta t6
  (description "Fix internals/architecture.md: remove duplicate spl.rs references in parser update and test sections (was dfl.rs + spl.rs)")
  (agent "claude")
  (file "docs/src/internals/architecture.md"))

; ── t7: rebuild mdbook ──────────────────────────────────────────
(normally t7
  (and update_trust_guide update_getting_started update_readme update_spl_reference update_cli_reference update_architecture)
  rebuild_book)
(meta t7
  (description "Run mdbook build to regenerate docs/book/ from updated sources")
  (agent "claude"))

(claims agent:claude
  :at "2026-20-11T17:00:20Z"
  (given completed_t1))

