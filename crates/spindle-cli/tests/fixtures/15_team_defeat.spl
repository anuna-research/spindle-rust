(given a)
(given b)
(given c)
(normally r1 a p)
(normally r2 b p)
(normally r3 c (not p))

; Without superiority, both p and ~p are defeasibly derivable
; (superiority is explicit and per-rule, not per-team)
; EXPECT: +d a
; EXPECT: +d b
; EXPECT: +d c
; EXPECT: +d p
; EXPECT: +d ~p
